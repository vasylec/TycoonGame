<Page x:Class="TycoonGame.Scenes.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="GamePage">

    <Grid x:Name="RootGrid" Background="#0B1020" MouseMove="RootGrid_MouseMove" PreviewMouseLeftButtonUp="RootGrid_MouseLeftButtonUp">
        <Grid.LayoutTransform>
            <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HUD -->
        <Border Grid.Row="0" Background="#DD111827" Padding="12">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="ISLAND TYCOON" FontSize="26" FontWeight="Bold" Foreground="#FACC15" Margin="0,0,18,0"/>
                    <TextBlock x:Name="SaveNameText" Text="Save: -" FontSize="16" Foreground="White" Margin="0,0,14,0"/>
                    <TextBlock x:Name="MoneyText" Text="$0" FontSize="18" FontWeight="Bold" Foreground="#86EFAC" Margin="0,0,14,0"/>
                    <TextBlock x:Name="IncomeText" Text="Income/s: $0" FontSize="16" Foreground="#93C5FD" Margin="0,0,14,0"/>
                    <TextBlock x:Name="PopulationText" Text="Pop: 0" FontSize="16" Foreground="#FDBA74"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Width="120" Height="46" Margin="0,0,8,0" Click="Settings_Click" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image x:Name="BtnImage" Source="/Assets/Buttons/ButtonSettings.png" Stretch="Fill"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BtnImage" Property="Source" Value="/Assets/Buttons/ButtonSettings_Hover.png"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BtnImage" Property="Source" Value="/Assets/Buttons/ButtonSettings_Click.png"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="120" Height="46" Margin="0,0,8,0" Click="Save_Click" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image x:Name="BtnImage" Source="/Assets/Buttons/ButtonSave.png" Stretch="Fill"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BtnImage" Property="Source" Value="/Assets/Buttons/ButtonSave_Hover.png"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BtnImage" Property="Source" Value="/Assets/Buttons/ButtonSave_Click.png"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="49" Height="46" Margin="0,0,8,0" Click="Back_Click" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image x:Name="BtnImage" Source="/Assets/Buttons/ButtonBackArrow.png" Stretch="Fill"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BtnImage" Property="Source" Value="/Assets/Buttons/ButtonBackArrow_Click.png"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="120" Height="46" Click="Reset_Click" Background="Transparent" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Image x:Name="BtnImage" Source="/Assets/Buttons/ButtonDelete.png" Stretch="Fill"/>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BtnImage" Property="Source" Value="/Assets/Buttons/ButtonDelete_Hover.png"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BtnImage" Property="Source" Value="/Assets/Buttons/ButtonDelete_Click.png"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Build palette -->
            <Border Grid.Column="0" Margin="10" Padding="10" Background="#CC1F2937" CornerRadius="10" BorderBrush="#334155" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Build Menu" FontSize="22" FontWeight="Bold" Foreground="#E5E7EB" Margin="0,0,0,10"/>
                    <TextBlock Text="1) Selectezi clÄƒdire È™i dai click pe lot" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                    <TextBlock Text="2) Sau drag &amp; drop clÄƒdire pe lot" Foreground="#CBD5E1" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Button x:Name="BtnHouse" Tag="House" Height="72" Margin="0,0,0,8"
                            PreviewMouseLeftButtonDown="SelectBuilding_MouseDown"
                            PreviewMouseMove="Building_PreviewMouseMove">
                        <DockPanel>
                            <Image Source="/Assets/Buildings/BuildingBeige.png" Width="60" Height="60" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="House" FontWeight="Bold"/>
                                <TextBlock Text="Cost: $100 | +6/s | Pop +4" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button x:Name="BtnShop" Tag="Shop" Height="72" Margin="0,0,0,8"
                            PreviewMouseLeftButtonDown="SelectBuilding_MouseDown"
                            PreviewMouseMove="Building_PreviewMouseMove">
                        <DockPanel>
                            <Image Source="/Assets/Buildings/BuildingBlue.png" Width="60" Height="60" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Shop" FontWeight="Bold"/>
                                <TextBlock Text="Cost: $220 | +12/s | Pop +2" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Button x:Name="BtnFactory" Tag="Factory" Height="72" Margin="0,0,0,12"
                            PreviewMouseLeftButtonDown="SelectBuilding_MouseDown"
                            PreviewMouseMove="Building_PreviewMouseMove">
                        <DockPanel>
                            <Image Source="/Assets/Buildings/BuildingWhite.png" Width="60" Height="60" Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Factory" FontWeight="Bold"/>
                                <TextBlock Text="Cost: $300 | +18/s | Pop +1" FontSize="11"/>
                            </StackPanel>
                        </DockPanel>
                    </Button>

                    <Border Background="#111827" CornerRadius="8" Padding="10">
                        <TextBlock x:Name="SelectionText" Foreground="#E2E8F0" Text="Selected building: none" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Island map -->
            <Border Grid.Column="1" Margin="10" Padding="10" Background="#CC0F172A" CornerRadius="10" BorderBrush="#334155" BorderThickness="1">
                <Grid>
                    <Canvas x:Name="IslandCanvas" Background="#1E293B">
                        <!-- Ocean decoration -->
                        <Ellipse Canvas.Left="30" Canvas.Top="20" Width="980" Height="620" Fill="#1D4ED8" Opacity="0.25"/>

                        <!-- Island -->
                        <Ellipse Canvas.Left="130" Canvas.Top="80" Width="780" Height="500" Fill="#3F6212" Stroke="#84CC16" StrokeThickness="5"/>

                        <!-- Predefined lots -->
                        <Border x:Name="Lot1" Tag="0" Canvas.Left="235" Canvas.Top="160" Width="165" Height="135" Background="#FDE68A" BorderBrush="#92400E" BorderThickness="2" CornerRadius="8"
                                PreviewMouseLeftButtonDown="Lot_Click">
                            <TextBlock Text="Lot 1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>

                        <Border x:Name="Lot2" Tag="1" Canvas.Left="440" Canvas.Top="135" Width="165" Height="135" Background="#FDE68A" BorderBrush="#92400E" BorderThickness="2" CornerRadius="8"
                                PreviewMouseLeftButtonDown="Lot_Click">
                            <TextBlock Text="Lot 2" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>

                        <Border x:Name="Lot3" Tag="2" Canvas.Left="645" Canvas.Top="160" Width="165" Height="135" Background="#FDE68A" BorderBrush="#92400E" BorderThickness="2" CornerRadius="8"
                                PreviewMouseLeftButtonDown="Lot_Click">
                            <TextBlock Text="Lot 3" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>

                        <Border x:Name="Lot4" Tag="3" Canvas.Left="300" Canvas.Top="340" Width="165" Height="135" Background="#FDE68A" BorderBrush="#92400E" BorderThickness="2" CornerRadius="8"
                                PreviewMouseLeftButtonDown="Lot_Click">
                            <TextBlock Text="Lot 4" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>

                        <Border x:Name="Lot5" Tag="4" Canvas.Left="515" Canvas.Top="320" Width="165" Height="135" Background="#FDE68A" BorderBrush="#92400E" BorderThickness="2" CornerRadius="8"
                                PreviewMouseLeftButtonDown="Lot_Click">
                            <TextBlock Text="Lot 5" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>

                        <Border x:Name="Lot6" Tag="5" Canvas.Left="730" Canvas.Top="350" Width="165" Height="135" Background="#FDE68A" BorderBrush="#92400E" BorderThickness="2" CornerRadius="8"
                                PreviewMouseLeftButtonDown="Lot_Click">
                            <TextBlock Text="Lot 6" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>

                        <Border x:Name="UpgradePanel" Visibility="Collapsed" Canvas.Left="30" Canvas.Top="30"
                                Width="250" Height="290" Background="#EE111827" BorderBrush="#64748B" BorderThickness="2" CornerRadius="10"
                                Opacity="0" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="UpgradePanelScale" ScaleX="0.82" ScaleY="0.82"/>
                            </Border.RenderTransform>
                            <StackPanel Margin="10">
                                <TextBlock Text="Upgrade" Foreground="White" FontSize="18" FontWeight="Bold"/>
                                <Image x:Name="UpgradePreviewImage" Width="96" Height="72" Margin="0,8,0,6" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="UpgradeStatsText" Foreground="#E2E8F0" TextWrapping="Wrap" FontSize="12"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button Content="Close" Width="60" Margin="0,0,8,0" Click="UpgradeClose_Click"/>
                                    <Button x:Name="DemolishButton" Content="Delete" Width="70" Margin="0,0,8,0" Click="DemolishConfirm_Click"/>
                                    <Button x:Name="UpgradeButton" Content="Upgrade" Width="80" Click="UpgradeConfirm_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#DD0F172A" Padding="10">
            <TextBlock x:Name="StatusText" Text="Alege o clÄƒdire È™i plaseazÄƒ pe lot." Foreground="#E2E8F0" FontSize="14"/>
        </Border>

        <!-- Drag ghost overlay -->
        <Canvas Grid.RowSpan="3" IsHitTestVisible="False" Panel.ZIndex="999">
            <Image x:Name="DragGhost"
                   Width="78" Height="62"
                   Visibility="Collapsed"
                   Opacity="0.95"
                   RenderTransformOrigin="0.5,0.01">
                <Image.RenderTransform>
                    <RotateTransform x:Name="DragGhostRotate" Angle="0"/>
                </Image.RenderTransform>
            </Image>
        </Canvas>
    </Grid>
</Page>




