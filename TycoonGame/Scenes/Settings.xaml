<Page x:Class="TycoonGame.Scenes.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Loaded="Settings_Loaded">

    <Grid>
        <Rectangle>
            <Rectangle.Fill>
                <ImageBrush x:Name="AnimatedBackgroundBrush"
                            Stretch="UniformToFill"
                            Opacity="0.95"
                            TileMode="Tile"
                            ViewportUnits="RelativeToBoundingBox"
                            Viewport="0,0,1,1"
                            AlignmentX="Left"
                            AlignmentY="Top">
                    <ImageBrush.RelativeTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.18" ScaleY="1.18" CenterX="0.5" CenterY="0.5"/>
                            <TranslateTransform x:Name="BackgroundTranslate" X="0" Y="0"/>
                        </TransformGroup>
                    </ImageBrush.RelativeTransform>
                </ImageBrush>
            </Rectangle.Fill>
            <Rectangle.Effect>
                <BlurEffect Radius="4"/>
            </Rectangle.Effect>
        </Rectangle>

        <Border Background="#4A000000"/>

        <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" Height="390">
            <Border Background="#66000000" CornerRadius="14" BorderThickness="1" BorderBrush="#88FFFFFF"/>

            <Grid Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="18"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="22"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Settings" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White"/>
                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="Audio" FontSize="22" HorizontalAlignment="Center" Foreground="#E8E8E8" Margin="0,4,0,0"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Master" FontSize="16" VerticalAlignment="Center" Foreground="White" Grid.ColumnSpan="2" Margin="0,0,458,0"/>
                <Slider x:Name="trackMaster" Grid.Row="3" Grid.Column="1" Margin="28,6,0,6" Minimum="0" Maximum="100" Value="100" ValueChanged="trackMaster_ValueChanged"/>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="SFX" FontSize="16" VerticalAlignment="Center" Foreground="White"/>
                <Slider x:Name="trackSFX" Grid.Row="4" Grid.Column="1" Margin="28,6,0,6" Minimum="0" Maximum="100" Value="50" ValueChanged="trackSFX_ValueChanged"/>

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Music" FontSize="16" VerticalAlignment="Center" Foreground="White"/>
                <Slider x:Name="trackMusic" Grid.Row="5" Grid.Column="1" Margin="28,6,0,6" Minimum="0" Maximum="100" Value="50" ValueChanged="trackMusic_ValueChanged"/>

                <Button x:Name="btnBack" HorizontalAlignment="Left" VerticalAlignment="Top" Height="46" Width="49"
                        Click="BackButton_Click" Cursor="Hand" Margin="10,10,0,0" Background="Transparent" BorderThickness="0" Grid.RowSpan="2">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Image x:Name="btnImage" Source="/Assets/Buttons/ButtonBackArrow.png" Stretch="Fill"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="btnImage" Property="Source" Value="/Assets/Buttons/ButtonBackArrow_Click.png"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
